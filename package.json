{
  "name": "moxuan-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "墨轩 MoXuan - 本地 AI 写作工作台",
  "main": "dist/main/index.js",
  "author": "MoXuan",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.node.json --watch\" \"wait-on tcp:5173 dist/main/index.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && vue-tsc -p tsconfig.renderer.json --noEmit",
    "lint": "eslint src tests --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "pack": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@tiptap/core": "^2.11.5",
    "@tiptap/vue-3": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "diff": "^7.0.0",
    "lucide-vue-next": "^0.468.0",
    "naive-ui": "^2.41.0",
    "pinia": "^2.3.1",
    "tiptap-markdown": "^0.8.10",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.51.0",
    "@types/diff": "^6.0.0",
    "@types/node": "^22.13.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.20.1",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.15.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.7",
    "vue-tsc": "^2.2.2",
    "wait-on": "^8.0.2"
  }
}
